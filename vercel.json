{
  "version": 2,
  "name": "calendrier-fr",
  "routes": [
    {
      "src": "/ferie/([^/]+)",
      "dest": "/event/$1",
      "status": 301
    },
    {
      "src": "/proposer",
      "dest": "/proposer.html"
    },
    {
      "src": "/admin/login",
      "dest": "/admin/login.html"
    },
    {
      "src": "/admin",
      "dest": "/admin/index.html"
    },
    { "src": "/api/admin-data", "dest": "/api/admin-data.js" },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/calendrier.ics",
      "dest": "/api/calendrier.ics.js",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/event/([^/]+)",
      "dest": "/api/event-page.js?slug=$1"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PATCH, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    },
    {
      "source": "/event/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*\\.ics)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/calendar; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' cdnjs.cloudflare.com fonts.googleapis.com fonts.gstatic.com va.vercel-scripts.com; style-src 'self' 'unsafe-inline' cdnjs.cloudflare.com fonts.googleapis.com fonts.gstatic.com; font-src 'self' fonts.gstatic.com cdnjs.cloudflare.com data:; img-src 'self' data: api.qrserver.com; connect-src 'self' geo.api.gouv.fr data.education.gouv.fr calendrier-fr.tibotsr.dev api.calendrier-fr.tibotsr.dev vitals.vercel-insights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "env": {
    "CALENDAR_JSON_URL": "https://raw.githubusercontent.com/TiboTsr/calendrier-france-ics/data/calendrier.json",
    "GENERATED_DATA_REPO": "TiboTsr/calendrier-france-ics",
    "GENERATED_DATA_BRANCH": "data"
  }
}
